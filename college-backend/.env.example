# Copy this file to .env and fill in your real values.
# Never commit the real .env file to version control.

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=college_site

# --- Server ---
PORT=4000
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_secret
# Comma-separated frontend origins. Example: https://your-school.vercel.app
FRONTEND_URL=http://localhost:3000

# --- Email (SendGrid example) ---
SENDGRID_API_KEY=
FROM_EMAIL=admissions@yourcollege.edu

# --- SMS (Twilio example) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Payments ---
PAYMENT_MERCHANT_ID=
PAYMENT_SECRET_KEY=
